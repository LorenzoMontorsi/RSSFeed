# Copia in .env solo per una prova in locale:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# Su Coolify queste variabili si impostano nella risorsa, non in un file committato.
# Le password vanno scelte senza spazi, virgolette o simboli $.

TZ=Europe/Rome
CRON_MIN=4,19,34,49

# Dominio pubblico, con https, senza barra finale.
# In Coolify lascia che sia generato da SERVICE_URL_FRESHRSS_80 dopo aver assegnato il dominio.
SERVICE_URL_FRESHRSS_80=http://localhost:8080

ADMIN_EMAIL=admin@example.net
ADMIN_PASSWORD=cambia-questa-password
ADMIN_API_PASSWORD=cambia-questa-password-api
SERVICE_PASSWORD_DB=cambia-questa-password-db

DB_BASE=freshrss
DB_USER=freshrss
